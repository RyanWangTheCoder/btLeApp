# Release signing — copy this to .env and fill in your values.
# Source before running bundleRelease:
#   source .env && java -cp gradle/wrapper/gradle-wrapper.jar org.gradle.wrapper.GradleWrapperMain bundleRelease
#
# Generate keystore (run once):
#   keytool -genkey -v -keystore release.keystore -alias athlete_emg -keyalg RSA -keysize 2048 -validity 10000

export KEYSTORE_PASSWORD=
export KEY_ALIAS=athlete_emg
export KEY_PASSWORD=
