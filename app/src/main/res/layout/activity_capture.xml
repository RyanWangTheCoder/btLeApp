<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".capture.SessionCaptureActivity">

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: Initializing..." />

    <TextView
        android:id="@+id/txtDemoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="● DEMO MODE"
        android:textColor="#FFFFFFFF"
        android:textStyle="bold"
        android:textSize="12sp"
        android:background="#FFCC0000"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/txtBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery: --%" />
    <TextView
            android:id="@+id/txtHeartRate"
            android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="HR: --" />
    <TextView
            android:id="@+id/txtSpo2"
            android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="SpO2: --%" />
</LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Session Recorder"
        android:textStyle="bold"
        android:textSize="18sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnStartSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start" />

        <Button
            android:id="@+id/btnStopSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Stop" />

        <Button
            android:id="@+id/btnProcessSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Process" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <Switch
            android:id="@+id/swFreeze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Freeze" />

        <Button
            android:id="@+id/btnWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Win:10s" />

        <Button
            android:id="@+id/btnRawHz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="RAW:500" />

        <Button
            android:id="@+id/btnImuScale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="IMU:Auto" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtImuThr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="IMU marker threshold: 20000" />

    <SeekBar
        android:id="@+id/seekImuThr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="75000"
        android:progress="15000" />

    <TextView
        android:id="@+id/txtStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textSize="12sp"
        android:text="" />

    <TextView
        android:id="@+id/txtFatigue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Fatigue: --" />

    <com.clj.blesample.views.SimplePlotView
        android:id="@+id/emgPlot"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="8dp" />

    <com.clj.blesample.views.SimplePlotView
        android:id="@+id/imuPlot"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="Keep this screen in the foreground while recording." />
</LinearLayout>
