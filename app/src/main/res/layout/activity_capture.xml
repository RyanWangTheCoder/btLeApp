<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Session Recorder"
        android:textStyle="bold"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="Idle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnStartSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start" />

        <Button
            android:id="@+id/btnStopSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Stop &amp; Save" />
    </LinearLayout>

    <Button
        android:id="@+id/btnProcessSession"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Process this session" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <Switch
            android:id="@+id/swFreeze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Freeze" />

        <Button
            android:id="@+id/btnWindow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Window: 10s" />

        <Button
            android:id="@+id/btnRawHz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="RAW: 500Hz" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtImuThr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="IMU marker threshold: 20000" />

    <SeekBar
        android:id="@+id/seekImuThr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="75000"
        android:progress="15000" />

    <TextView
        android:id="@+id/txtStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textSize="12sp"
        android:text="" />

    <com.clj.blesample.views.SimplePlotView
        android:id="@+id/emgPlot"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp" />

    <com.clj.blesample.views.SimplePlotView
        android:id="@+id/imuPlot"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:text="Keep this screen in the foreground while recording." />
</LinearLayout>
